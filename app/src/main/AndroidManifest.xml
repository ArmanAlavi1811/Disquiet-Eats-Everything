<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/goshneicon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/goshneicon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Disquiet_Eats_Everything"
        tools:targetApi="31">
        <activity
            android:name=".feature.how_to_screen.presentation.ui.HowToScreen"
            android:exported="false"/>
        <activity
            android:name=".application.MainActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>